@baseUrl = http://localhost:3000

### Información pública
GET {{baseUrl}}/

### Estado de la API (pública)
GET {{baseUrl}}/health

### Registrar a Ana (primer uso: devuelve 201)
POST {{baseUrl}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "name": "Ana Torres",
  "email": "ana@example.com",
  "password": "una frase de acceso segura"
}

### Registrar a Luis para probar el aislamiento entre cuentas
POST {{baseUrl}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "name": "Luis Pérez",
  "email": "luis@example.com",
  "password": "otra frase de acceso segura"
}

### Intentar registrar el mismo correo (esperado: 409)
POST {{baseUrl}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "name": "Otra Ana",
  "email": "ANA@EXAMPLE.COM",
  "password": "una frase de acceso segura"
}

### Datos de registro no válidos (esperado: 422)
POST {{baseUrl}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "name": "",
  "email": "correo-invalido",
  "password": "corta"
}

### Intentar asignar el rol admin durante el registro (esperado: 422)
POST {{baseUrl}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "name": "Usuario no autorizado",
  "email": "rol@example.com",
  "password": "una frase de acceso segura",
  "role": "admin"
}

### Login de Ana
# @name loginAna
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "ana@example.com",
  "password": "una frase de acceso segura"
}

### Token Bearer de Ana
@anaToken = {{loginAna.response.body.accessToken}}

### Login de Luis
# @name loginLuis
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "luis@example.com",
  "password": "otra frase de acceso segura"
}

### Token Bearer de Luis
@luisToken = {{loginLuis.response.body.accessToken}}

### Login con contraseña incorrecta (esperado: 401)
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "ana@example.com",
  "password": "contraseña incorrecta"
}

### Login con usuario inexistente (mismo 401 y mensaje)
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "nadie@example.com",
  "password": "contraseña incorrecta"
}

### Consultar usuario autenticado (esperado: 200)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{anaToken}}
Accept: application/json

### Perfil sin token (esperado: 401)
GET {{baseUrl}}/auth/me
Accept: application/json

### Perfil con token inválido (esperado: 401)
GET {{baseUrl}}/auth/me
Authorization: Bearer token.invalido.manipulado
Accept: application/json

### Estadísticas con cuenta normal (esperado: 403)
GET {{baseUrl}}/admin/stats
Authorization: Bearer {{luisToken}}
Accept: application/json

### Para probar como admin, ejecuta en MySQL esta instrucción:
# UPDATE users SET role = 'admin' WHERE email = 'ana@example.com';
# authenticate carga el rol actual de MySQL, así que no es necesario renovar el token.

### Estadísticas como Ana después de asignarle rol admin (esperado: 200)
GET {{baseUrl}}/admin/stats
Authorization: Bearer {{anaToken}}
Accept: application/json

### Crear una tarea privada de Ana
# @name createAnaTask
POST {{baseUrl}}/tasks
Authorization: Bearer {{anaToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Tarea privada de Ana",
  "description": "Solo Ana debe acceder a esta tarea",
  "status": "pending",
  "priority": "high",
  "dueDate": null
}

### Guardar el id de la tarea de Ana
@anaTaskId = {{createAnaTask.response.body.id}}

### Listar tareas de Ana
GET {{baseUrl}}/tasks
Authorization: Bearer {{anaToken}}
Accept: application/json

### Luis no ve las tareas de Ana
GET {{baseUrl}}/tasks
Authorization: Bearer {{luisToken}}
Accept: application/json

### Ana consulta su propia tarea (esperado: 200)
GET {{baseUrl}}/tasks/{{anaTaskId}}
Authorization: Bearer {{anaToken}}
Accept: application/json

### Luis intenta consultar la tarea de Ana (esperado: 404)
GET {{baseUrl}}/tasks/{{anaTaskId}}
Authorization: Bearer {{luisToken}}
Accept: application/json

### Luis intenta modificar la tarea de Ana (esperado: 404)
PATCH {{baseUrl}}/tasks/{{anaTaskId}}
Authorization: Bearer {{luisToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Intento de cambio ajeno"
}

### Luis intenta eliminar la tarea de Ana (esperado: 404)
DELETE {{baseUrl}}/tasks/{{anaTaskId}}
Authorization: Bearer {{luisToken}}
Accept: application/json

### Filtrar tareas de Ana por estado
GET {{baseUrl}}/tasks?status=pending
Authorization: Bearer {{anaToken}}
Accept: application/json

### Filtrar tareas de Ana por prioridad
GET {{baseUrl}}/tasks?priority=high
Authorization: Bearer {{anaToken}}
Accept: application/json

### Sustituir la tarea propia de Ana
PUT {{baseUrl}}/tasks/{{anaTaskId}}
Authorization: Bearer {{anaToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Tarea actualizada por Ana",
  "description": "Ana es la propietaria",
  "status": "in_progress",
  "priority": "medium",
  "dueDate": null
}

### Modificar parcialmente la tarea propia de Ana
PATCH {{baseUrl}}/tasks/{{anaTaskId}}
Authorization: Bearer {{anaToken}}
Content-Type: application/json
Accept: application/json

{
  "status": "completed"
}

### Sin token no se pueden listar tareas (esperado: 401)
GET {{baseUrl}}/tasks
Accept: application/json

### Token inválido no permite acceder a tareas (esperado: 401)
GET {{baseUrl}}/tasks
Authorization: Bearer token.invalido.manipulado
Accept: application/json

### Identificador no válido
GET {{baseUrl}}/tasks/abc
Authorization: Bearer {{anaToken}}
Accept: application/json

### Tarea inexistente
GET {{baseUrl}}/tasks/999999
Authorization: Bearer {{anaToken}}
Accept: application/json

### Datos de tarea no válidos
POST {{baseUrl}}/tasks
Authorization: Bearer {{anaToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "",
  "status": "terminada",
  "priority": "urgente",
  "dueDate": "15/10/2026"
}

### El cliente no puede elegir el propietario (esperado: 422)
POST {{baseUrl}}/tasks
Authorization: Bearer {{anaToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "No se acepta userId del cliente",
  "userId": 1
}

### JSON mal formado (esperado: 400)
POST {{baseUrl}}/tasks
Authorization: Bearer {{anaToken}}
Content-Type: application/json

{
  "title": "Falta cerrar el objeto"

### Eliminar la tarea propia al final de la práctica
DELETE {{baseUrl}}/tasks/{{anaTaskId}}
Authorization: Bearer {{anaToken}}
Accept: application/json
